# Voltaway — variabili d'ambiente (riferimento)
# Copia in `.env` e compila. NON committare `.env` con valori reali.
# In produzione i segreti vanno configurati nella UI/CLI Netlify, non qui.

# --- Integrazione ricarica (OCPI) ---
# mock = usa MockOcpiProvider con dati seed (default demo)
# live = usa un hub OCPI reale (Hubject/Gireve) — richiede accordi
OCPI_MODE=mock
OCPI_TOKEN=
OCPI_BASE_URL=

# --- Pagamenti (Stripe, usare chiavi TEST in demo) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Mappa (MapLibre + tiles OpenStreetMap/Protomaps) ---
NEXT_PUBLIC_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# --- Database (impostata automaticamente da Netlify, non a mano) ---
# NETLIFY_DB_URL=

# --- Osservabilità (opzionale in demo) ---
SENTRY_DSN=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:8888
