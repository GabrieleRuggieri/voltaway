# Voltaway — variabili d'ambiente (riferimento).
# Copia in `.env` e compila. NON committare `.env` con valori reali.
#
# Politica locale: servizi nostri in Docker Compose; esterni solo se gratuiti.
# Vedi ARCHITECTURE.md §2 e README.md "Politica sviluppo locale".

# --- Postgres ---
POSTGRES_USER=voltaway
POSTGRES_PASSWORD=voltaway
POSTGRES_DB=voltaway
# Usata da api/worker (host "postgres" = nome del servizio Compose)
DATABASE_URL=postgres://voltaway:voltaway@postgres:5432/voltaway

# --- Redis (cache / pub-sub / coda BullMQ) ---
REDIS_URL=redis://redis:6379

# --- Keycloak (OIDC / RBAC) — in container, nessun costo ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
OIDC_ISSUER_URL=http://keycloak:8080/realms/voltaway
OIDC_CLIENT_ID=voltaway-api
OIDC_CLIENT_SECRET=voltaway-api-secret

# --- Integrazione ricarica (OCPI) — ocpi-sim in Compose, nessun accordo ---
# sim  = servizio ocpi-sim (OCPI 2.2.1) con dati seed (default locale)
# live = hub OCPI reale (Hubject/Gireve) — solo in produzione, richiede accordi
OCPI_MODE=sim
OCPI_BASE_URL=http://ocpi-sim:4000
OCPI_TOKEN=sim-token

# --- Pagamenti — Stripe TEST mode (servizio esterno GRATUITO) ---
# 1. Crea account su https://stripe.com (gratis)
# 2. Dashboard → Developers → API keys → usa le chiavi "test"
# 3. Per i webhook in locale: Stripe CLI (gratuita) → stripe listen
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Object storage (MinIO in container, S3-compatibile) ---
MINIO_ROOT_USER=voltaway
MINIO_ROOT_PASSWORD=voltaway-secret
S3_ENDPOINT=http://minio:9000
S3_BUCKET=voltaway

# --- Email (Mailpit in container) ---
SMTP_HOST=mailpit
SMTP_PORT=1025

# --- Osservabilità (Grafana OTel LGTM, profilo obs) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://observability:4318

# --- Mappa — OpenStreetMap tiles (servizio esterno GRATUITO, richiede internet) ---
# Usage policy: https://operations.osmfoundation.org/policies/tiles/
NEXT_PUBLIC_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# --- Front-end ---
NEXT_PUBLIC_API_URL=http://api.voltaway.localhost
NEXT_PUBLIC_OIDC_ISSUER_URL=http://auth.voltaway.localhost/realms/voltaway
